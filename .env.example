# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is git-ignored and is the ONLY place the real credentials live -
# never put them in the source code.
# ---------------------------------------------------------------------------

# --- required --------------------------------------------------------------
# Get it from @BotFather:  /newbot  or  /token
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# --- local Bot API server (optional, but needed for long videos) -----------
# The official Bot API only lets bots download 20 MB and upload 50 MB, which a
# 20-minute video exceeds.  Run your own Bot API server (docker-compose does
# it for you) to raise the limits to 2000 MB.  Get the values from
# https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=replace_with_your_api_hash

# When these are set the bot talks to your local server instead of
# api.telegram.org.  docker-compose.yml sets them automatically.
#TELEGRAM_API_BASE_URL=http://localhost:8081/bot
#TELEGRAM_BASE_FILE_URL=http://localhost:8081/file/bot

# --- limits & job handling (optional) --------------------------------------
# Maximum size of a video the bot accepts, in bytes (default: 2000 MB).
# Only takes full effect with the local Bot API server - the official API
# hard-caps bot downloads at 20 MB regardless of this value.
#MAX_VIDEO_SIZE=209715200      # 200 MB
# Maximum size of the final video the bot will send, in bytes (default: 0 =
# derived from the API mode).  Same caveat: the official API hard-caps bot
# uploads at 50 MB.
# For the web interface this is the ONLY applicable cap - the browser download
# does not go through Telegram, so the 50 MB upload limit above never applies
# there and the renderer does not compress the video to fit it.
#MAX_OUTPUT_SIZE=209715200     # 200 MB
# How many jobs are processed at the same time (default: 1).
#MAX_CONCURRENT_JOBS=1
# How many jobs a single user may have queued/running (default: 1).
#MAX_JOBS_PER_USER=1
# Overall time budget per job, in seconds (default: 10800 = 3 h).
#JOB_TIMEOUT_SECONDS=10800
# Refuse to start a job when less than this much disk space is free.
#MIN_FREE_DISK_GB=5

# --- vocal separation (optional) -------------------------------------------
#MODEL_NAME=htdemucs          # htdemucs | htdemucs_ft | mdx_extra | ...
#DEMUCS_DEVICE=auto           # auto | cpu | cuda
# Parallel segment workers (demucs -j).  0 = auto: half of the CPU cores, at
# most 8 (measured ~1.7x faster separation than a single worker).  Each worker
# needs ~1.5 GB of RAM - on a server with less than ~12 GB free set
# DEMUCS_JOBS=4 explicitly; set 1 on a very small / low-RAM host.
#DEMUCS_JOBS=0
#AUDIO_LOUDNESS_NORM=true     # normalise the vocals to -16 LUFS
# Crossfade between the separator's internal segments.  Demucs' own default is
# 0.25; the portable default here is 0.1, which runs the same model at the same
# precision but ~15% faster.  Only raise it if you can hear seams between
# segments in very quiet passages.
#DEMUCS_OVERLAP=0.1
# Rarely needed; passed straight to demucs (appended after the standard args,
# so it can override any of them).
#DEMUCS_EXTRA_ARGS=

# --- output (optional) -----------------------------------------------------
# Output canvas.  The default 1280x720 ("720p") is sharp - frames are
# extracted from the source at exactly this size (never upscaled), and the
# encode stays cheap because the video holds only 150 stills.  Drop to
# 640x360 for the smallest files (e.g. to stay under the 50 MB upload cap of
# the official Bot API); the source aspect ratio is always preserved.
#MAX_OUTPUT_WIDTH=1280
#MAX_OUTPUT_HEIGHT=720
# The video shows 150 stills, so a low frame rate is visually identical and
# much faster to encode (default 10).
#SLIDESHOW_FPS=10
# x264 speed / quality knobs for the slideshow and the final render
# (default veryfast / 20 for both).
#SLIDESHOW_PRESET=veryfast
#SLIDESHOW_CRF=20
#FINAL_PRESET=veryfast
#FINAL_CRF=20
#SAVE_OUTPUT_COPY=false       # keep a copy of every finished video
#DELETE_TEMP_AFTER_SEND=true  # remove the working files once sent
#KEEP_TEMP_ON_ERROR=false     # keep the working files when a job fails
#OUTPUT_DIRECTORY=output
#TEMP_DIRECTORY=temp

# --- web interface (optional) ----------------------------------------------
# Browser front end (web/): upload the video on a page, the server processes
# it, you download the result.  No Telegram involved, so the Bot API size
# limits never apply - only MAX_VIDEO_SIZE above does.
#
# Local start:      python -m web.app        then open http://localhost:8080
# With Docker:      the `web` service serves http://<server>/ (port 80)
#                   WEB_PUBLISH_PORT=8080 .env   ->  http://<server>:8080/
#
# Set a password BEFORE the interface is reachable from the internet: the
# whole UI, downloads included, then sits behind HTTP Basic auth.
#WEB_USERNAME=admin
#WEB_PASSWORD=change-me-please
# How long (seconds) a finished video stays downloadable before the server
# removes it (default: 3600 = 1 hour).  The file is also removed right after
# a successful download.
#WEB_JOB_TTL_SECONDS=3600
# Filename the browser suggests when saving the finished video.
#WEB_DOWNLOAD_NAME=150-pictures
# Listen address/port of the server itself; the Docker setup sets WEB_PORT
# to the container's internal port (8080), so change these only for a local
# run (default: 0.0.0.0:8080).
#WEB_HOST=0.0.0.0
#WEB_PORT=8080

# --- overlay (optional) ------------------------------------------------------
# How the overlay image is put on the video.  Position and size are picked per
# job (buttons in the bot, dropdowns on the web page); these are the defaults.
# Sizes: original | 25% | 50% | 75% | 100% (fraction of the canvas width)
#OVERLAY_DEFAULT_POSITION=center
#OVERLAY_DEFAULT_SIZE=original

# --- logging (optional) ----------------------------------------------------
#LOG_LEVEL=INFO
#LOG_FILE=logs/bot.log        # also write a rotating log file
